{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "askdown",
  "version": "0.3.1",
  "identifier": "com.cyberneura.askdown",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "askdown",
        "width": 900,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: askdown: http://askdown.localhost; media-src 'self' askdown: http://askdown.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
